class Solution:
    def combine(self, n: int, k: int) -> List[List[int]]:
        result = []
        temp = []
        
        def helper(start, k):
            if k <= 0:
                result.append(temp[:])
                return 
            if start >  n:
                return
            for val in range(start, n+1):
                temp.append(val)
                helper(val + 1, k - 1)
                temp.pop()

        helper(1,k)
        return result
